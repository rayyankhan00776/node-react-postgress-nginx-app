#!/bin/sh

set -eu

echo "🔍 Running pre-commit hook..."

GITIGNORE=".gitignore"

##############################################################################
# Ensure .gitignore exists
##############################################################################

touch "$GITIGNORE"

##############################################################################
# Required ignore rules
##############################################################################

IGNORE_RULES="
.env
.env.*
!.env.example
!.env.*.example
"

for rule in $IGNORE_RULES
do
    escaped=$(printf '%s\n' "$rule" | sed 's/[.[\*^$()+?{|]/\\&/g')

    # Uncomment if present
    if grep -Eq "^[[:space:]]*#[[:space:]]*$escaped[[:space:]]*$" "$GITIGNORE"; then
        tmp=$(mktemp)

        awk -v r="$rule" '
        {
            line=$0
            gsub(/^[[:space:]]*#[[:space:]]*/, "", line)

            if(line==r){
                print r
            }else{
                print $0
            }
        }
        ' "$GITIGNORE" > "$tmp"

        mv "$tmp" "$GITIGNORE"
    fi

    # Append if missing
    if ! grep -Fxq "$rule" "$GITIGNORE"; then
        echo "$rule" >> "$GITIGNORE"
    fi
done

git add "$GITIGNORE"

##############################################################################
# Generate .env.example
##############################################################################

find . -type f -name ".env" | while read -r ENV
do
    EXAMPLE="$(dirname "$ENV")/.env.example"

    echo "Generating $EXAMPLE"

    {
        echo "# ----------------------------------------------------------------"
        echo "# AUTO GENERATED"
        echo "# Generated from $(basename "$ENV")"
        echo "# Do NOT store secrets in this file."
        echo "# ----------------------------------------------------------------"
        echo

        awk '
        /^[[:space:]]*#/{
            print
            next
        }

        /^[[:space:]]*$/{
            print
            next
        }

        {
            key=$0
            sub(/=.*/, "", key)
            print key "="
        }
        ' "$ENV"

    } > "$EXAMPLE"

    git add "$EXAMPLE"
done

##############################################################################
# Automatically unstage .env files
##############################################################################

STAGED_ENV=$(git diff --cached --name-only | grep -E '(^|/)\.env(\..*)?$' || true)

if [ -n "$STAGED_ENV" ]; then

    echo
    echo "⚠️  Sensitive .env files detected."
    echo

    echo "$STAGED_ENV" | while read -r file
    do
        [ -z "$file" ] && continue

        if git ls-files --error-unmatch "$file" >/dev/null 2>&1
        then
            git rm --cached --quiet "$file"
        else
            git restore --staged "$file" 2>/dev/null || true
        fi

        echo "Removed from Git index: $file"
    done

    echo
    echo "✅ .env files were removed from the commit."
    echo "   They remain on your computer."
    echo
fi

##############################################################################
# Final check
##############################################################################

LEFT=$(git diff --cached --name-only | grep -E '(^|/)\.env(\..*)?$' || true)

if [ -n "$LEFT" ]; then
    echo
    echo "❌ Failed to remove some .env files."
    echo
    echo "$LEFT"
    exit 1
fi

echo
echo "✅ Updated .gitignore"
echo "✅ Generated .env.example files"
echo "✅ Removed staged .env files"
echo
echo "✔ Pre-commit checks passed."

exit 0