services:
  db:
    image: postgres:17-alpine
    container_name: taskflow_db
    restart: always
    environment:
      POSTGRES_USER: $username
      POSTGRES_DB: taskflow_pro
      POSTGRES_HOST_AUTH_METHOD: trust # Trust local socket connections for development convenience
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $username -d taskflow_pro"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: taskflow_backend
    restart: always
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "5050:5050"
    environment:
      PORT: 5050
      NODE_ENV: production
      DATABASE_URL: postgresql://$username@db:5432/taskflow_pro
      JWT_SECRET: some_super_secret_access_key_123456!
      JWT_REFRESH_SECRET: some_super_secret_refresh_key_123456!
      JWT_EXPIRES_IN: 15m
      JWT_REFRESH_EXPIRES_IN: 7d
      CORS_ORIGIN: http://localhost:8080
      UPLOAD_PATH: src/uploads
    volumes:
      - uploads_data:/app/src/uploads

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: taskflow_frontend
    restart: always
    depends_on:
      - backend
    environment:
      VITE_API_BASE_URL: http://localhost:5050/api
    ports:
      - "8080:80"

volumes:
  pgdata:
  uploads_data:
