# Stage 1: Build the React application
FROM node:22-slim AS builder

WORKDIR /app

# Copy package files from frontend subdirectory
COPY package*.json ./

RUN npm install

# Copy source files
COPY . .

# Build the production assets
RUN npm run build

# Stage 2: Serve the static files using Nginx
FROM nginx:latest

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration if needed, or use default
# Since this container only serves static files, standard Nginx config is fine
# but we can add a simple config to handle SPA routing (React Router)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
